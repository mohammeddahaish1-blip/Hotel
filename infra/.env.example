# Copy to infra/.env on the server. Never commit the real file.

# Your app's address (DNS A record must point at this server)
DOMAIN=app.example.com

# Supabase project the app talks to (public values, also visible in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Used only by the backup / move scripts (infra/scripts), never by the app ---
# Direct database connection string (Supabase dashboard > Connect)
SOURCE_DB_URL=
TARGET_DB_URL=
# Encrypts backups; keep a copy in a password manager. Lose it = backups can't be opened.
BACKUP_PASSPHRASE=
