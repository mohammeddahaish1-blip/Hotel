# Copy to .env.local (local development) or set the same names in Vercel → Settings → Environment Variables.
# Never commit the real file: .env* is ignored by git, only this example is tracked.

# Supabase project (Supabase dashboard → Project Settings → API).
# Both are public values that also reach the browser; data is protected by row-level security in the database.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Optional — server only, never exposed to the browser.
# Turns on the AI assistant and reading amounts from photographed shop invoices.
# Leave empty to run without them.
ANTHROPIC_API_KEY=
